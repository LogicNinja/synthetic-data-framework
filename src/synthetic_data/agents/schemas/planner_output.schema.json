{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario Planner Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective", "label", "technique_ids", "coverage_gaps", "hard_cases", "generation_budget", "scenario_request", "rationale"],
  "properties": {
    "objective": { "type": "string", "minLength": 1 },
    "label": { "enum": ["malicious", "benign"] },
    "technique_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" } },
    "coverage_gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "hard_cases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "generation_budget": { "type": "integer", "minimum": 1, "maximum": 20 },
    "scenario_request": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "label": { "const": "benign" } } },
      "then": { "properties": { "technique_ids": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "label": { "const": "malicious" } } },
      "then": { "properties": { "technique_ids": { "minItems": 1 } } }
    }
  ]
}
