{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Defender-Guided Adversarial Scenario Proposals",
  "type": "object",
  "additionalProperties": false,
  "required": ["weakness_summary", "scenario_requests"],
  "properties": {
    "weakness_summary": { "type": "string", "minLength": 1 },
    "scenario_requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_request", "label", "target_failure_ids", "hard_case", "technique_ids"],
        "properties": {
          "scenario_request": { "type": "string", "minLength": 1 },
          "label": { "enum": ["malicious", "benign"] },
          "target_failure_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "hard_case": { "type": "string", "minLength": 1 },
          "technique_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" } }
        }
      }
    }
  }
}
